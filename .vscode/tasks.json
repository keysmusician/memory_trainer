{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Vite",
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"type": "npm",
			"script": "dev",
			"detail": "Launches the Vite development server",
			"dependsOn": [
				"Open Browser"
			],
			"problemMatcher": [
				{
					"pattern": [
						{
							"regexp": ".",
							"file": 1,
							"line": 1,
							"column": 1,
							"message": 1
						}
					],
					"background": {
						"activeOnStart": true,
						"beginsPattern": {
							"regexp": "."
						},
						"endsPattern": {
							"regexp": "."
						}
					},
				}
			]
		},
		{
			"type": "npm",
			"script": "dev",
			"group": "build",
			"label": "npm: dev - Memory Trainer",
			"detail": "Runs Vite",
			"runOptions": {
				"runOn": "folderOpen"
			}
		},
		{
			"label": "Open Browser",
			"type": "shell",
			"command": "open",
			"args": [
				"http://localhost:5173"
			],
			"windows": {
				"command": "start"
			},
			"linux": {
				"command": "xdg-open"
			},
			"isBackground": true,
			"problemMatcher": []
		}
	]
}
